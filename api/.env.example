# Copy to .env — never commit real values
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/astra
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
DEBUG=true

# --- Day 4 (S2): REQUIRED — the app refuses to boot without it. ---
# Generate one with:  python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=

# --- Day 4 (S1): demo-login endpoint gate — true ONLY on the demo machine. ---
DEMO_MODE=false

# --- Day 4: assessment backend. rules = deterministic stub (default).
# llm = LLM path with automatic degradation back to rules on any failure. ---
ASSESSMENT_BACKEND=rules
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Gnani AI (Phase 0 spike, see docs/plan-phases.md) ---
# Register at https://app.gnani.ai/voice/ — put the REAL value in .env, never here.
# Auth header is X-API-Key-ID (NOT Authorization: Bearer). Docs: docs.gnani.ai/llms.txt
# Leave blank until the spike has proven a working call — do not build on an assumption.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# --- Multi-provider free LLMs (assistant + assessment, zero-cost tiers) ---
# Fill any subset; MultiLlmBackend tries them in order (groq -> openrouter -> nvidia)
# and falls back to rules if all fail. Leave blank to stay on rules_stub.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

NVIDIA_API_KEY=
NVIDIA_MODEL=google/gemma-4-31b-it
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Weather (OpenWeatherMap free tier) ---
# Register at https://openweathermap.org/api -> put real value in .env
WEATHER_API_KEY=
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# --- CORS (Phase 6 deployability) ---
# JSON ARRAY (not a comma-separated string). The parser expects JSON:
#   CORS_ORIGINS=["https://astra.vercel.app","http://localhost:3000"]
CORS_ORIGINS=["http://localhost:3000"]

# --- Routing graph (AD-4, Phase 6 deployability) ---
# true  = load the OSM graph in a background task at startup (~5 s, ~200 MB)
# false = build it lazily on the first /route request
ROUTING_PREWARM=true

# --- Evidence media storage (AD-8, Phase 6 deployability) ---
# local = api/uploads/ on disk (development)
# s3    = any S3-compatible bucket — REQUIRED in production, because the
#         Render free tier has an ephemeral filesystem (a redeploy or a
#         spin-down would delete every evidence photo).
MEDIA_STORAGE=local
MEDIA_URL_TTL_SECONDS=3600

# Cloudflare R2 (or AWS S3 / MinIO) — used when MEDIA_STORAGE=s3
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=evidence

# --- Vision / image evidence (Phase 3) ---
# Hosted-API image understanding. VISION_PROVIDER = openai (default) | gemini (stub).
VISION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Auth rate limiting (brute-force protection) ---
# Per IP and per endpoint: a registration burst never locks citizens out of
# logging in behind the same NAT address.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
