# Copy to .env — never commit real values
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/astra
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
DEBUG=true

# --- Day 4 (S2): REQUIRED — the app refuses to boot without it. ---
# Generate one with:  python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=

# --- Day 4 (S1): demo-login endpoint gate — true ONLY on the demo machine. ---
DEMO_MODE=false

# --- Day 4: assessment backend. rules = deterministic stub (default).
# llm = LLM path with automatic degradation back to rules on any failure. ---
ASSESSMENT_BACKEND=rules
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Gnani AI (Phase 0 spike, see docs/plan-phases.md) ---
# Register at https://app.gnani.ai/voice/ — put the REAL value in .env, never here.
# Auth header is X-API-Key-ID (NOT Authorization: Bearer). Docs: docs.gnani.ai/llms.txt
# Leave blank until the spike has proven a working call — do not build on an assumption.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# --- Multi-provider free LLMs (assistant + assessment, zero-cost tiers) ---
# Fill any subset; MultiLlmBackend tries them in order (groq -> openrouter -> nvidia)
# and falls back to rules if all fail. Leave blank to stay on rules_stub.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

NVIDIA_API_KEY=
NVIDIA_MODEL=google/gemma-4-31b-it
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
